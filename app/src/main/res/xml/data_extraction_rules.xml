<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup / device-transfer rules for Android 12+. The Gemini API key's ciphertext is excluded:
   it is bound to this device's Keystore key, and a secret should never leave the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="gemini_credential.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="gemini_credential.xml" />
    </device-transfer>
</data-extraction-rules>
