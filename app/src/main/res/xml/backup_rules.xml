<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 and lower (see data_extraction_rules.xml for Android 12+).
   The Gemini API key's ciphertext is excluded: it is bound to this device's Keystore key, and a
   secret should never leave the device in a backup.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="gemini_credential.xml" />
</full-backup-content>
